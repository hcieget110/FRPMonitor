<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FRPMonitor</AssemblyName>
    <Version>1.1.5</Version>
    <ApplicationIcon>Assets/frp-monitor.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);tools/**;dist/**;qa/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/frp-monitor.ico" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <Compile Remove="tools/**/*.cs" />
    <EmbeddedResource Remove="tools/**/*" />
    <None Remove="tools/**/*" />
  </ItemGroup>
</Project>
